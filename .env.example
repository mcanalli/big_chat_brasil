# ==========================================
# CONFIGURAÇÕES GERAIS
# ==========================================
NODE_ENV=development
PORT=3000

# ==========================================
# POSTGRESQL
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=bcb_user
DB_PASSWORD=bcb_password
DB_NAME=bcb_db

# Se o seu projeto utilizar DB_USERNAME e DB_DATABASE no TypeORM, inclua também:
DB_USERNAME=bcb_user
DB_DATABASE=bcb_db

# ==========================================
# REDIS
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ==========================================
# RABBITMQ
# ==========================================
RABBITMQ_DEFAULT_USER=bcb_mq_user
RABBITMQ_DEFAULT_PASS=bcb_mq_password
RABBITMQ_URI=amqp://bcb_mq_user:bcb_mq_password@localhost:5672

# ==========================================
# SEEDER
# ==========================================
RUN_SEEDER=true

# ==========================================
# GEMINI AI
# ==========================================
GEMINI_API_KEY=sua_chave_do_gemini_aqui

# ==========================================
# FRONTEND
# ==========================================
API_URL=http://localhost:3000

